# kb-advisor environment (copy to kb.env, chmod 600; kb.env is gitignored)
# Values for one client's deployment.

ADVISOR_TOKEN=change-me
ADVISOR_PORT=8001
# ADVISOR_HOST=127.0.0.1
# ADVISOR_TOP_K=5
# ADVISOR_MAX_Q=500
# ADVISOR_MAX_NOTE=1000
# ADVISOR_MAX_CITATIONS=6
# ADVISOR_LOG_DIR=/var/lib/kb-advisor/logs

# OpenRouter two-tier generation (free first, paid fallback)
OPENROUTER_API_KEY=
# Leave OPENROUTER_MODEL_FREE empty to go straight to the paid tier.
OPENROUTER_MODEL_FREE=
OPENROUTER_MODEL_PAID=google/gemini-2.5-flash-lite
# OPENROUTER_TIMEOUT_S=12
# OPENROUTER_MAX_TOKENS=1000
# BRAIN_TEMPERATURE=0.2
