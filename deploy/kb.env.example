# kb-advisor environment (copy to kb.env, chmod 600; kb.env is gitignored)
# Values for one client's deployment.

# REQUIRED. Generate with: openssl rand -hex 32
# An empty value or this example placeholder makes the server reject every
# request with 401 (fail closed). For local development only, set
# ADVISOR_ALLOW_ANON=1 instead.
ADVISOR_TOKEN=
ADVISOR_PORT=8001
# ADVISOR_HOST=127.0.0.1
# ADVISOR_TOP_K=5
# ADVISOR_MAX_Q=500
# ADVISOR_MAX_NOTE=1000
# ADVISOR_MAX_CITATIONS=6
# ADVISOR_LOG_DIR=/var/lib/kb-advisor/logs
# Concurrent handler cap. Past this, requests wait in the listen backlog, which
# is the intended backpressure on a 1 GB box.
# ADVISOR_MAX_THREADS=8
# Wall clock bound for one crisis-regex match. A match that exceeds it disables
# the crisis detector for the process and logs CRITICAL.
# ADVISOR_REGEX_TIMEOUT_S=0.25

# OpenRouter two-tier generation (free first, paid fallback)
OPENROUTER_API_KEY=
# Leave OPENROUTER_MODEL_FREE empty to go straight to the paid tier.
OPENROUTER_MODEL_FREE=
OPENROUTER_MODEL_PAID=google/gemini-2.5-flash-lite
# OPENROUTER_TIMEOUT_S=12
# OPENROUTER_MAX_TOKENS=1000
# BRAIN_TEMPERATURE=0.2
